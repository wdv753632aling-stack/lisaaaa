  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    // 初始化單指地圖
    const map = L.map('leaflet-map', { zoomControl: false }).setView([35.6895, 139.6917], 11);
    L.control.zoom({ position: 'topleft' }).addTo(map);
    L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}&hl=zh-TW', { maxZoom: 20, attribution: '© Google' }).addTo(map);

    let currentMarkers = [];
    let currentPolyline = null;
    let currentPlaceData = { title: "", url: "", img: "", desc: "", lat: 0, lng: 0 };
    let currentTab = 'day1-content';
    let isGoogleMode = false;

    // 手機版切換面板高度
    function togglePanel() {
      const panel = document.querySelector('.itinerary-panel');
      const btn = document.querySelector('.mobile-toggle');
      panel.classList.toggle('collapsed');
      if(panel.classList.contains('collapsed')) {
        btn.innerHTML = '🔼 展開行程表';
        btn.style.background = '#34a853';
      } else {
        btn.innerHTML = '🔽 收起行程表，查看全螢幕地圖';
        btn.style.background = '#1a73e8';
      }
    }

    // 雙地圖切換引擎 (單指滑動 vs 雙指 Google 探索)
    function toggleMapMode() {
      isGoogleMode = !isGoogleMode;
      const toggleBtn = document.getElementById('map-mode-toggle');
      const lMap = document.getElementById('leaflet-map');
      const gMap = document.getElementById('google-iframe');
      
      if(isGoogleMode) {
          toggleBtn.innerHTML = '🗺️ 切換回單指行程地圖';
          toggleBtn.style.color = '#ea4335';
          toggleBtn.style.borderColor = '#ea4335';
          lMap.style.display = 'none';
          gMap.style.display = 'block';
          const center = map.getCenter();
          gMap.src = `https://maps.google.com/maps?q=${center.lat},${center.lng}&z=16&output=embed`;
      } else {
          toggleBtn.innerHTML = '🔍 切換 Google 探索地圖';
          toggleBtn.style.color = '#1a73e8';
          toggleBtn.style.borderColor = '#1a73e8';
          lMap.style.display = 'block';
          gMap.style.display = 'none';
          setTimeout(() => { map.invalidateSize(); }, 100);
      }
    }

    // 地鐵圖縮放
    let subwayBaseHeight = 1600;
    function zoomSubway(factor) {
      subwayBaseHeight *= factor;
      if (subwayBaseHeight < 600) subwayBaseHeight = 600;
      if (subwayBaseHeight > 6000) subwayBaseHeight = 6000;
      document.querySelector('#subway-map-wrapper img').style.height = subwayBaseHeight + 'px';
    }

    function openBottomSheet() { document.getElementById('custom-bottom-sheet').classList.add('open'); }
    function closeBottomSheet() { document.getElementById('custom-bottom-sheet').classList.remove('open'); }
    function openCurrentGMaps() { if(currentPlaceData.url) window.open(currentPlaceData.url, '_blank'); }

    function exploreNearby() {
        const gMap = document.getElementById('google-iframe');
        if (currentTab !== 'hotel-content') {
            isGoogleMode = true;
            const toggleBtn = document.getElementById('map-mode-toggle');
            toggleBtn.innerHTML = '🗺️ 切換回單指行程地圖';
            toggleBtn.style.color = '#ea4335';
            toggleBtn.style.borderColor = '#ea4335';
            document.getElementById('leaflet-map').style.display = 'none';
            gMap.style.display = 'block';
        }
        gMap.src = `https://maps.google.com/maps?q=${currentPlaceData.lat},${currentPlaceData.lng}&z=17&output=embed`;
        closeBottomSheet();
        if (window.innerWidth <= 768) {
           const panel = document.querySelector('.itinerary-panel');
           if (!panel.classList.contains('collapsed')) togglePanel();
        }
    }

    // ---------------- 釘選與自訂行程系統 ----------------
    let favorites = JSON.parse(localStorage.getItem('tokyoFavs')) || [];

    function renderFavs() {
      const favList = document.getElementById('fav-list');
      if(!favList) return;
      favList.innerHTML = '';
      if(favorites.length === 0) {
        favList.innerHTML = '<p style="color:#888; font-size:13px; text-align:center;">目前還沒有最愛景點喔！<br>點擊下方任一景點的「⭐」即可一鍵加入。</p>';
        return;
      }
      favorites.forEach((fav, index) => {
        const html = `
          <div class="event-card" style="position:relative;" onclick="openCustomSheet('${fav.title}', '${fav.url}', '${fav.img}', '${fav.desc}', ${fav.lat}, ${fav.lng})">
            <img class="event-img" src="${fav.img}" alt="Fav">
            <div class="event-info">
              <h4 style="font-size:15px; margin-bottom:5px;">${fav.title}</h4>
              <p style="font-size:12px; color:#888; margin-bottom:8px; line-height:1.3;">${fav.desc.substring(0,35)}...</p>
              <div class="action-buttons" style="margin-top:0;">
                <button class="action-btn map-btn" onclick="window.open('${fav.url}', '_blank'); event.stopPropagation();" style="padding:6px; font-size:12px;">🗺️ 導航</button>
                <button class="action-btn" onclick="removeFav(${index}); event.stopPropagation();" style="background:#ffeeee; color:#e74c3c; padding:6px; font-size:12px; border:1px solid #fadbd8;">🗑️ 移除</button>
              </div>
            </div>
          </div>`;
        favList.insertAdjacentHTML('beforeend', html);
      });
    }

    function saveToFavoritesFromBottomSheet() {
      if(!currentPlaceData.title) return;
      if (currentTab === 'hotel-content' || currentTab === 'transport-content' || currentTab === 'subway-content') {
          const exists = favorites.find(f => f.title === currentPlaceData.title);
          if(!exists) {
              favorites.unshift(currentPlaceData);
              localStorage.setItem('tokyoFavs', JSON.stringify(favorites));
              renderFavs();
              alert("✅ 已成功加入「飯店周邊」的我的最愛清單！");
          } else { alert("這個地點已經在您的最愛中囉！"); }
      } else if (currentTab.startsWith('day')) {
          const dayNum = currentTab.replace('day', '').replace('-content', '');
          let dayList = JSON.parse(localStorage.getItem(`tokyoDay${dayNum}`)) || [];
          const exists = dayList.find(f => f.title === currentPlaceData.title);
          if(!exists) {
              dayList.push(currentPlaceData);
              localStorage.setItem(`tokyoDay${dayNum}`, JSON.stringify(dayList));
              renderDayCustom();
              alert(`✅ 已成功釘選至 Day ${dayNum} 的專屬行程！`);
          } else { alert(`這個地點已經在 Day ${dayNum} 中囉！`); }
      }
    }

    function removeFav(index) {
      if(confirm('確定要移除這個最愛地點嗎？')) {
        favorites.splice(index, 1);
        localStorage.setItem('tokyoFavs', JSON.stringify(favorites));
        renderFavs();
      }
    }

    function quickAddPlace() {
        const name = prompt("請輸入您找到的景點/餐廳名稱：\n(系統將自動為您轉換為 Google 導航連結)");
        if(!name) return;
        const searchParam = encodeURIComponent(name);
        const url = `https://www.google.com/maps/search/?api=1&query=${searchParam}`;
        
        let centerLat = 35.694602;
        let centerLng = 139.813897;
        if (currentTab !== 'hotel-content' && currentTab !== 'subway-content') {
           const center = map.getCenter();
           centerLat = center.lat; centerLng = center.lng;
        }
        
        const newItem = {
            title: name, url: url, img: 'https://via.placeholder.com/72?text=New', desc: '🌟 您專屬的自訂探索行程', lat: centerLat, lng: centerLng
        };

        if (currentTab === 'hotel-content' || currentTab === 'transport-content' || currentTab === 'subway-content') {
            favorites.unshift(newItem);
            localStorage.setItem('tokyoFavs', JSON.stringify(favorites));
            renderFavs();
            alert("✅ 已成功加入「飯店周邊」的我的最愛清單！\n請滑動至面板最上方查看。");
        } else if (currentTab.startsWith('day')) {
            const dayNum = currentTab.replace('day', '').replace('-content', '');
            let dayList = JSON.parse(localStorage.getItem(`tokyoDay${dayNum}`)) || [];
            dayList.push(newItem);
            localStorage.setItem(`tokyoDay${dayNum}`, JSON.stringify(dayList));
            renderDayCustom();
            alert(`✅ 已成功加入 Day ${dayNum} 的專屬行程！\n請滑動至面板最下方查看。`);
        }
    }
    
    function searchNearby(keyword) {
        isGoogleMode = true;
        document.getElementById('leaflet-map').style.display = 'none';
        document.getElementById('subway-map-container').style.display = 'none';
        const gMap = document.getElementById('google-iframe');
        gMap.style.display = 'block';
        
        const toggleBtn = document.getElementById('map-mode-toggle');
        toggleBtn.innerHTML = '🗺️ 切換回單指行程地圖';
        toggleBtn.style.color = '#ea4335';
        toggleBtn.style.borderColor = '#ea4335';
        
        let lat = currentPlaceData.lat || map.getCenter().lat;
        let lng = currentPlaceData.lng || map.getCenter().lng;
        gMap.src = `https://maps.google.com/maps?q=${encodeURIComponent(keyword)} near ${lat},${lng}&z=15&output=embed`;
        
        closeBottomSheet();
        if (window.innerWidth <= 768) {
           const panel = document.querySelector('.itinerary-panel');
           if (!panel.classList.contains('collapsed')) togglePanel();
        }
    }

    function addDayCustom(day) {
        const name = prompt(`請輸入要在 Day ${day} 新增的店家名稱：`);
        if(!name) return;
        const searchParam = encodeURIComponent(name);
        const url = `https://www.google.com/maps/search/?api=1&query=${searchParam}`;
        let dayList = JSON.parse(localStorage.getItem(`tokyoDay${day}`)) || [];
        dayList.push({ title: name, url: url, img: 'https://via.placeholder.com/72?text=New', desc: '🌟 自訂隱藏版行程', lat: 35.6895, lng: 139.6917 });
        localStorage.setItem(`tokyoDay${day}`, JSON.stringify(dayList));
        renderDayCustom();
    }

    function removeDayCustom(day, index) {
        if(confirm('確定要移除這個行程嗎？')) {
            let dayList = JSON.parse(localStorage.getItem(`tokyoDay${day}`)) || [];
            dayList.splice(index, 1);
            localStorage.setItem(`tokyoDay${day}`, JSON.stringify(dayList));
            renderDayCustom();
        }
    }

    function renderDayCustom() {
        for(let i=1; i<=5; i++) {
            const listEl = document.getElementById(`day${i}-custom-list`);
            if(!listEl) continue;
            listEl.innerHTML = '';
            let dayList = JSON.parse(localStorage.getItem(`tokyoDay${i}`)) || [];
            dayList.forEach((item, index) => {
                const html = `
                <div class="event-card" style="position:relative;" onclick="openCustomSheet('${item.title}', '${item.url}', '${item.img}', '${item.desc}', ${item.lat}, ${item.lng})">
                  <img class="event-img" src="${item.img}" alt="Custom">
                  <div class="event-info">
                    <span class="time" style="color:#e74c3c;">🌟 自訂釘選</span>
                    <h4 style="margin-bottom:5px;">${item.title}</h4>
                    <div class="action-buttons" style="margin-top:5px;">
                      <button class="action-btn map-btn" onclick="window.open('${item.url}', '_blank'); event.stopPropagation();" style="padding:6px; font-size:12px;">🗺️ 導航</button>
                      <button class="action-btn" onclick="removeDayCustom(${i}, ${index}); event.stopPropagation();" style="background:#ffeeee; color:#e74c3c; padding:6px; font-size:12px; border:1px solid #fadbd8;">🗑️ 移除</button>
                    </div>
                  </div>
                </div>`;
                listEl.insertAdjacentHTML('beforeend', html);
            });
        }
    }

    function attachPinButtons() {
      document.querySelectorAll('.event-card').forEach(card => {
        if(card.querySelector('.card-pin-btn') || card.closest('#fav-list') || card.closest('[id$="-custom-list"]') || !card.hasAttribute('data-lat')) return;
        const pinBtn = document.createElement('button');
        pinBtn.className = 'card-pin-btn';
        pinBtn.innerHTML = '⭐';
        
        pinBtn.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          const title = card.querySelector('h4') ? card.querySelector('h4').innerText : '未知景點';
          const img = card.querySelector('img') ? card.querySelector('img').src : '';
          const lat = card.getAttribute('data-lat');
          const lng = card.getAttribute('data-lng');
          const query = card.getAttribute('data-query');
          const guide = card.querySelector('.transit-guide') ? card.querySelector('.transit-guide').innerHTML : '';
          const url = `https://www.google.com/maps/search/?api=1&query=${query ? encodeURIComponent(query) : lat+','+lng}`;
          const placeData = { title, url, img, desc: guide, lat: lat, lng: lng };
          
          if (currentTab === 'hotel-content' || currentTab === 'transport-content' || currentTab === 'subway-content') {
              const exists = favorites.find(f => f.title === placeData.title);
              if(!exists) {
                  favorites.unshift(placeData);
                  localStorage.setItem('tokyoFavs', JSON.stringify(favorites));
                  renderFavs();
                  showPinSuccess(pinBtn);
              } else alert('這已經在您的最愛清單中囉！');
          } else if (currentTab.startsWith('day')) {
              const dayNum = currentTab.replace('day', '').replace('-content', '');
              let dayList = JSON.parse(localStorage.getItem(`tokyoDay${dayNum}`)) || [];
              const exists = dayList.find(f => f.title === placeData.title);
              if(!exists) {
                  dayList.push(placeData);
                  localStorage.setItem(`tokyoDay${dayNum}`, JSON.stringify(dayList));
                  renderDayCustom();
                  showPinSuccess(pinBtn);
              } else alert(`這已經在 Day ${dayNum} 中囉！`);
          }
        });
        card.style.position = 'relative';
        card.appendChild(pinBtn);
      });
    }

    function showPinSuccess(btn) {
        btn.innerHTML = '✅'; btn.style.background = '#e6f4ea';
        setTimeout(() => { btn.innerHTML = '⭐'; btn.style.background = '#fff'; }, 2000);
    }

    window.openCustomSheet = function(title, url, img, desc, lat, lng) {
        currentPlaceData = { title, url, img, desc, lat: lat||35.694602, lng: lng||139.813897 }; 
        document.getElementById('bs-title').innerText = title;
        document.getElementById('bs-img').src = img;
        document.getElementById('bs-desc').innerHTML = desc;
        document.getElementById('bs-rating-score').innerText = (Math.random() * (4.8 - 3.8) + 3.8).toFixed(1);
        document.getElementById('bs-reviews').innerText = `(${Math.floor(Math.random() * 3000) + 200})`;
        openBottomSheet();
    }
    // -----------------------------------------------------------

    function clearSubwayPins() {
      const wrapper = document.getElementById('subway-map-wrapper');
      wrapper.querySelectorAll('.subway-pin, .transfer-ring').forEach(pin => pin.remove());
      const svg = document.getElementById('subway-svg-overlay');
      if (svg) svg.innerHTML = '';
    }

    function showSubwayTransfer(el) {
      document.getElementById('leaflet-map').style.display = 'none';
      document.getElementById('google-iframe').style.display = 'none';
      document.getElementById('subway-map-container').style.display = 'block';
      document.getElementById('zoom-controls').style.display = 'flex';
      document.getElementById('map-mode-toggle').style.display = 'none';
      document.getElementById('search-supermarket-btn').style.display = 'none';
      document.getElementById('quick-add-btn').style.display = 'none';
      
      clearSubwayPins();
      closeBottomSheet();
      
      const ptsStr = el.getAttribute('data-subway-paths');
      const ringsStr = el.getAttribute('data-subway-rings');
      const endsStr = el.getAttribute('data-subway-ends');
      if(!ptsStr || !ringsStr || !endsStr) return;
      
      const paths = JSON.parse(ptsStr), rings = JSON.parse(ringsStr), ends = JSON.parse(endsStr);
      const wrapper = document.getElementById('subway-map-wrapper');
      const svg = document.getElementById('subway-svg-overlay');
      
      paths.forEach(p => {
        for(let i=0; i < p.points.length - 1; i++) {
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', p.points[i].x + '%'); line.setAttribute('y1', p.points[i].y + '%');
          line.setAttribute('x2', p.points[i+1].x + '%'); line.setAttribute('y2', p.points[i+1].y + '%');
          line.setAttribute('stroke', p.color); line.setAttribute('stroke-width', '5');
          line.setAttribute('stroke-linecap', 'round'); line.setAttribute('stroke-dasharray', '8 8');
          svg.appendChild(line);
        }
      });

      ends.forEach((pt) => {
        const pin = document.createElement('div');
        pin.className = 'subway-pin bouncing';
        pin.style.left = pt.x + '%'; pin.style.top = pt.y + '%';
        pin.innerHTML = `<svg viewBox="0 0 32 42" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%; filter:drop-shadow(0 3px 4px rgba(0,0,0,0.4));"><path fill="#2c3e50" d="M16,0C7.163,0,0,7.163,0,16c0,11.2,16,26,16,26s16-14.8,16-26C32,7.163,24.837,0,16,0z"/></svg><div class="pin-text" style="position:absolute;top:6px;width:100%;text-align:center;color:white;font-weight:bold;font-size:14px;">📍</div><div class="subway-pin-text" style="background:#2c3e50; z-index:200;">${pt.name}</div>`;
        wrapper.appendChild(pin);
      });

      rings.forEach(pt => {
        const ring = document.createElement('div');
        ring.className = 'transfer-ring';
        ring.style.left = pt.x + '%'; ring.style.top = pt.y + '%';
        wrapper.appendChild(ring);
        const pin = document.createElement('div');
        pin.className = 'subway-pin';
        pin.style.left = pt.x + '%'; pin.style.top = pt.y + '%';
        pin.innerHTML = `<div class="subway-pin-text" style="background:#e74c3c; z-index:200;">${pt.name}</div>`;
        wrapper.appendChild(pin);
      });
      
      setTimeout(() => {
         const container = document.getElementById('subway-map-container');
         const scrollX = (wrapper.offsetWidth * (ends[0].x / 100)) - (container.offsetWidth / 2);
         const scrollY = (wrapper.offsetHeight * (ends[0].y / 100)) - (container.offsetHeight / 2);
         container.scrollTo({ left: scrollX, top: scrollY, behavior: 'smooth' });
         if (window.innerWidth <= 768) {
           const panel = document.querySelector('.itinerary-panel');
           if (!panel.classList.contains('collapsed')) togglePanel();
         }
      }, 150);
    }

    function updateMap(targetId) {
      currentMarkers.forEach(m => map.removeLayer(m));
      currentMarkers = [];
      if (currentPolyline) { map.removeLayer(currentPolyline); currentPolyline = null; }
      clearSubwayPins();
      closeBottomSheet();
      
      if(targetId === 'hotel-content') renderFavs();

      const container = document.getElementById(targetId);
      if (!container) return;

      const eventCards = container.querySelectorAll('.event-card');
      const latlngs = [];
      let pointIndex = 1;

      eventCards.forEach(card => {
        const lat = parseFloat(card.getAttribute('data-lat'));
        const lng = parseFloat(card.getAttribute('data-lng'));
        const queryName = card.getAttribute('data-query');
        const titleEl = card.querySelector('h4');
        const spotName = titleEl ? titleEl.innerText : '景點';

        if (!isNaN(lat) && !isNaN(lng)) {
          const searchParam = queryName ? encodeURIComponent(queryName) : `${lat},${lng}`;
          const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${searchParam}`;
          card.href = "javascript:void(0);"; 

          card.addEventListener('click', (e) => {
            if (e.target.tagName.toLowerCase() === 'button') { e.preventDefault(); return; }
            const guideText = card.querySelector('.transit-guide') ? card.querySelector('.transit-guide').innerText : "點擊上方「規劃路線」，即可開啟 Google Maps 導航前往。";
            currentPlaceData = { title: spotName, url: gmapsUrl, img: card.querySelector('img').src, desc: guideText, lat: lat, lng: lng };
            document.getElementById('bs-title').innerText = currentPlaceData.title;
            document.getElementById('bs-img').src = currentPlaceData.img;
            document.getElementById('bs-desc').innerHTML = card.querySelector('.transit-guide') ? card.querySelector('.transit-guide').innerHTML : currentPlaceData.desc;
            document.getElementById('bs-rating-score').innerText = (Math.random() * (4.8 - 3.8) + 3.8).toFixed(1);
            document.getElementById('bs-reviews').innerText = `(${Math.floor(Math.random() * 3000) + 200})`;
            openBottomSheet();
            if(targetId !== 'hotel-content' && targetId !== 'subway-content' && !isGoogleMode) { map.panTo([lat - 0.003, lng]); }
          });

          if (targetId !== 'hotel-content') {
            const pinHtml = `<div class="pin-marker"><svg viewBox="0 0 32 42" xmlns="http://www.w3.org/2000/svg"><path fill="#ea4335" d="M16,0C7.163,0,0,7.163,0,16c0,11.2,16,26,16,26s16-14.8,16-26C32,7.163,24.837,0,16,0z"/></svg><div class="pin-text">${pointIndex}</div></div>`;
            const customIcon = L.divIcon({ className: 'map-pin-container', html: pinHtml, iconSize: [32, 42], iconAnchor: [16, 42], popupAnchor: [0, -42] });
            const marker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
            marker.bindPopup(`<b>${spotName}</b><br><span style="font-size:12px; color:#1a73e8;">點擊卡片查看詳細資訊</span>`);
            marker.on('click', () => { card.click(); });
            currentMarkers.push(marker); latlngs.push([lat, lng]);
            card.addEventListener('mouseenter', () => { const iconElement = marker.getElement(); if (iconElement) iconElement.classList.add('bouncing'); });
            card.addEventListener('mouseleave', () => { const iconElement = marker.getElement(); if (iconElement) iconElement.classList.remove('bouncing'); });
            pointIndex++;
          }
        }
      });

      if (latlngs.length > 0 && targetId !== 'hotel-content') {
        currentPolyline = L.polyline(latlngs, { color: '#1a73e8', weight: 4, opacity: 0.8, dashArray: '8, 8' }).addTo(map);
        const isMobile = window.innerWidth <= 768;
        const paddingOptions = isMobile ? { paddingTopLeft: [20, 20], paddingBottomRight: [20, window.innerHeight * 0.45] } : { padding: [60, 60] };
        map.fitBounds(currentPolyline.getBounds(), paddingOptions);
      }
      attachPinButtons();
    }

    const buttons = document.querySelectorAll('.day-btn');
    const contents = document.querySelectorAll('.day-content');

    buttons.forEach(button => {
      button.addEventListener('click', (e) => {
        if(e.currentTarget.classList.contains('drive-btn')) return;

        buttons.forEach(btn => btn.classList.remove('active'));
        contents.forEach(content => content.classList.remove('active'));
        button.classList.add('active');
        
        const targetId = button.getAttribute('data-target');
        currentTab = targetId;
        
        // 切換控制按鈕顯示狀態
        if (targetId === 'subway-content' || targetId === 'transport-content') {
          document.getElementById('map-mode-toggle').style.display = 'none';
          document.getElementById('search-supermarket-btn').style.display = 'none';
          document.getElementById('quick-add-btn').style.display = 'none';
        } else if (targetId === 'hotel-content') {
          document.getElementById('map-mode-toggle').style.display = 'none';
          document.getElementById('search-supermarket-btn').style.display = 'flex';
          document.getElementById('quick-add-btn').style.display = 'flex';
        } else {
          document.getElementById('map-mode-toggle').style.display = 'flex';
          document.getElementById('search-supermarket-btn').style.display = 'flex';
          document.getElementById('quick-add-btn').style.display = 'flex';
          
          isGoogleMode = false;
          const toggleBtn = document.getElementById('map-mode-toggle');
          toggleBtn.innerHTML = '🔍 切換 Google 探索地圖';
          toggleBtn.style.color = '#1a73e8';
          toggleBtn.style.borderColor = '#1a73e8';
        }

        // 核心：切換地圖引擎
        if (targetId === 'subway-content') {
          document.getElementById('leaflet-map').style.display = 'none';
          document.getElementById('google-iframe').style.display = 'none';
          document.getElementById('subway-map-container').style.display = 'block';
          document.getElementById('zoom-controls').style.display = 'flex';
        } else if (targetId === 'hotel-content') {
          document.getElementById('leaflet-map').style.display = 'none';
          document.getElementById('google-iframe').style.display = 'block';
          document.getElementById('subway-map-container').style.display = 'none';
          document.getElementById('zoom-controls').style.display = 'none';
          document.getElementById('google-iframe').src = "https://maps.google.com/maps?q=35.694602,139.813897(相鐵FRESA INN 東京錦糸町)&z=16&output=embed";
        } else {
          document.getElementById('leaflet-map').style.display = 'block';
          document.getElementById('google-iframe').style.display = 'none';
          document.getElementById('subway-map-container').style.display = 'none';
          document.getElementById('zoom-controls').style.display = 'none';
        }

        document.getElementById(targetId).classList.add('active');
        
        // 延遲更新機制避免破圖當機
        setTimeout(() => {
          if (targetId !== 'subway-content' && targetId !== 'hotel-content') {
            map.invalidateSize();
          }
          if (targetId !== 'subway-content') {
            updateMap(targetId);
          }
        }, 150);
        
        if (window.innerWidth <= 768) {
          const panel = document.querySelector('.itinerary-panel');
          if (panel.classList.contains('collapsed')) { togglePanel(); }
        }
      });
    });

    setTimeout(() => { updateMap('day1-content'); renderFavs(); renderDayCustom(); }, 150);
  </script>
</body>
</html>
